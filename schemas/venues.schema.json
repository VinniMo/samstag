{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samstagloz.ch/schemas/venues.schema.json",
  "title": "Inventaire des lieux Samstag",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nom", "type_entite", "categorie", "commune", "adresse", "site_officiel", "preuve", "niveau", "adresse_statut", "activite", "canal", "date_controle", "latitude", "longitude", "notes", "collecte_active", "selection_nocturne", "motif_selection", "publication", "famille_sortie"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "nom": {"type": "string", "minLength": 1},
      "type_entite": {"type": "string"},
      "categorie": {"type": "string"},
      "commune": {"type": "string"},
      "adresse": {"type": "string"},
      "adresse_initiale": {"type": "string"},
      "site_officiel": {"type": "string"},
      "preuve": {"type": "string"},
      "niveau": {"type": "string"},
      "adresse_statut": {"type": "string"},
      "activite": {"type": "string"},
      "canal": {"type": "string"},
      "collecte": {"type": "string"},
      "date_controle": {"type": "string"},
      "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
      "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
      "preuve_geo": {"type": "string"},
      "notes": {"type": "string"},
      "collecte_active": {"type": "boolean"},
      "geo_statut": {"type": "string"},
      "zone": {"type": "string"},
      "alias_bars": {"type": "string"},
      "selection_nocturne": {"type": "string"},
      "motif_selection": {"type": "string"},
      "preuve_nocturne": {"type": "string"},
      "publication": {"type": "string"},
      "famille_sortie": {"type": "string"},
      "relation_programmateur": {"type": "string"},
      "preuve_bar": {"type": "string"},
      "preuve_commune": {"type": "string"}
    }
  }
}
