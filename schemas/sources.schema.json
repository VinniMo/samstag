{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samstagloz.ch/schemas/sources.schema.json",
  "title": "Registre des sources Samstag",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "venue_id", "nom", "canal", "preuve", "auto_publish", "priority", "enabled", "type", "notes"],
    "properties": {
      "id": {"type": "string", "pattern": "^(SRC_)?[A-Z][A-Z0-9]*$"},
      "venue_id": {"type": "string", "pattern": "^$|^[A-Z][A-Z0-9_]+$"},
      "nom": {"type": "string", "minLength": 1},
      "canal": {"type": "string", "format": "uri", "pattern": "^https?://"},
      "preuve": {"type": "string", "format": "uri", "pattern": "^https?://"},
      "auto_publish": {"type": "boolean"},
      "priority": {"type": "integer", "minimum": 0},
      "enabled": {"type": "boolean"},
      "type": {"enum": ["official", "aggregator"]},
      "notes": {"type": "string"},
      "allowed_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "widget_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "require_detail_confirmation": {"type": "boolean"}
    }
  }
}
