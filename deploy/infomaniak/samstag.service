[Unit]
Description=Samstag - agenda lausannois et collecte
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samstag
Group=samstag
WorkingDirectory=/opt/samstag/app
EnvironmentFile=/etc/samstag/samstag.env
ExecStart=/opt/samstag/venv/bin/python /opt/samstag/app/run_service.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=150
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/samstag
RestrictSUIDSGID=true
MemoryMax=512M
CPUQuota=50%
Nice=10
TasksMax=64

[Install]
WantedBy=multi-user.target
