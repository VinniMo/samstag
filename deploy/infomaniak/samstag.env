HOST=127.0.0.1
PORT=8011
WEB_WORKERS=1
COLLECTION_WORKERS=2
SAMSTAG_DB=/var/lib/samstag/samstag.sqlite3
SCRAPE_INTERVAL=3600
SERVICE_STOP_GRACE=120
FLASK_DEBUG=0
DEMO_ENABLED=0
COLLECTION_ON_VISIT=0
COOKIE_SECURE=1
MANUAL_REFRESH_ENABLED=0
# Définir SAMSTAG_SESSION_SECRET dans le fichier privé du serveur.
# SAMSTAG_REFRESH_TOKEN n'est requis que si la route manuelle est activée.
PYTHONDONTWRITEBYTECODE=1
