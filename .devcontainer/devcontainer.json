{
  "name": "Samstag",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "SAMSTAG_SKIP_BROWSER_INSTALL=1 make setup PYTHON=python3",
  "postAttachCommand": {
    "server": "make dev"
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Samstag",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
