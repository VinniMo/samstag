# Copier vers .env puis remplacer ce chemin par un chemin absolu local.
SAMSTAG_DB=/absolute/path/to/samstag/.local/samstag-dev.sqlite3

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
DEMO_ENABLED=0
COLLECTION_ON_VISIT=0
COLLECTION_WORKERS=2
COLLECTION_HORIZON_DAYS=90
SCRAPE_INTERVAL=3600
SCRAPE_TIMEOUT=12
SAMSTAG_SESSION_SECRET=local-development-only
